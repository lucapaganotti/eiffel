<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-20-0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-20-0 http://www.eiffel.com/developers/xml/configuration-1-20-0.xsd" name="epigpio" uuid="518EE0D3-16D5-4666-BCAB-44D7A548D3AF">
	<target name="epigpio">
		<root class="EPIGPIO" feature="make"/>
		<file_rule>
			<exclude>/CVS$</exclude>
			<exclude>/EIFGENs$</exclude>
			<exclude>/\.git$</exclude>
			<exclude>/\.svn$</exclude>
		</file_rule>
		<option warning="true" manifest_array_type="mismatch_warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="console_application" value="true"/>
		<setting name="dead_code_removal" value="feature"/>
		<external_include location="/home/buck/dev/eiffel/epigpio/c_pigpiod_if2">
			<description>pigpiod_if2 include</description>
			<condition>
				<platform excluded_value="windows macintosh vxworks"/>
			</condition>
		</external_include>
		<external_include location="/home/buck/dev/eiffel/epigpio/include">
			<description>epigpio include</description>
			<condition>
				<platform excluded_value="windows"/>
			</condition>
		</external_include>
		<external_cflag value="-pthread">
			<description>from https://abyz.me.uk/rpi/pigpio/pdif2.html</description>
			<condition>
				<platform excluded_value="windows macintosh vxworks"/>
			</condition>
		</external_cflag>
		<external_linker_flag value="-lpigpiod_if2 -lrt">
			<description>linker flags</description>
			<condition>
				<platform excluded_value="windows macintosh vxworks"/>
			</condition>
		</external_linker_flag>
		<precompile name="base_pre" location="$ISE_PRECOMP\base-scoop-safe.ecf"/>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<cluster name="epigpio" location=".\" recursive="true"/>
	</target>
</system>
