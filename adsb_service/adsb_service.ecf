<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-20-0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-20-0 http://www.eiffel.com/developers/xml/configuration-1-20-0.xsd" name="adsb_service" uuid="3EBA8AD0-2386-44CE-8333-B88E1D5EE634">
	<target name="adsb_service">
		<root class="ADSB_SERVICE_APPLICATION" feature="make"/>
		<file_rule>
			<exclude>/EIFGENs$</exclude>
			<exclude>/\..*$</exclude>
		</file_rule>
		<option>
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="console_application" value="true"/>
		<setting name="executable_name" value="adsb_service"/>
		<precompile name="base_pre" location="$ISE_PRECOMP\base-scoop-safe.ecf"/>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<library name="curl" location="$ISE_LIBRARY\library\cURL\cURL.ecf"/>
		<library name="eproj" location="\home\buck\dev\eiffel\library\eproj\eproj.ecf"/>
		<library name="json" location="$ISE_LIBRARY\contrib\library\text\parser\json\library\json.ecf"/>
		<library name="lex" location="$ISE_LIBRARY\library\lex\lex.ecf"/>
		<library name="logging" location="$ISE_LIBRARY\library\runtime\logging\logging.ecf"/>
		<library name="net" location="$ISE_LIBRARY\library\net\net.ecf"/>
		<library name="parse" location="$ISE_LIBRARY\library\parse\parse.ecf"/>
		<library name="postgresql" location="\home\buck\dev\eiffel\library\postgresql\eiffel-libpq-wrapper-master\generated_wrapper\eiffel\postgresql.ecf"/>
		<library name="preferences" location="$ISE_LIBRARY\library\preferences\preferences_xml.ecf"/>
		<library name="time_french" location="$ISE_LIBRARY\library\time\time_french.ecf"/>
		<library name="xml_parser" location="$ISE_LIBRARY\library\text\parser\xml\parser\xml_parser.ecf"/>
		<cluster name="adsb_service" location=".\" recursive="true"/>
	</target>
</system>
